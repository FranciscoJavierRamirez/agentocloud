# Variables públicas (se incrustan en el HTML al compilar). Copiar a .env y completar.
# URL de la agenda (Cal.com o Calendly). Vacía: el botón escribe al correo de contacto.
PUBLIC_AGENDA_URL=
# Clave PÚBLICA de Cloudflare Turnstile. Vacía: el widget no se carga.
PUBLIC_TURNSTILE_SITEKEY=
# Analítica sin cookies (opcional). Ejemplo: script de Plausible o de Umami y su dominio.
PUBLIC_ANALITICA_SRC=
PUBLIC_ANALITICA_DOMINIO=
