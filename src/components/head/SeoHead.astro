---
// Título, descripción, canónica, Open Graph e imagen para compartir.
interface Props {
  titulo: string;
  descripcion: string;
  imagen: string;
  imagenAlt: string;
  nombreSitio: string;
  lang: string;
  indexar?: boolean;
  palabrasClave?: string[];
}
const { titulo, descripcion, imagen, imagenAlt, nombreSitio, lang, indexar = true, palabrasClave } = Astro.props;
// En la dirección de borrador (*.pages.dev) ninguna página se indexa; la imagen para compartir sí se carga.
const borrador = Astro.site?.hostname.endsWith('.pages.dev') ?? false;
const indexable = indexar && !borrador;
const canonica = new URL(Astro.url.pathname, Astro.site);
const urlImagen = new URL(imagen, Astro.site);
---

<title>{titulo}</title>
<meta name="description" content={descripcion} />
{palabrasClave && <meta name="keywords" content={palabrasClave.join(', ')} />}
{indexable ? <link rel="canonical" href={canonica} /> : <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={nombreSitio} />
<meta property="og:locale" content={lang.replace('-', '_')} />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
<meta property="og:url" content={canonica} />
<meta property="og:image" content={urlImagen} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imagenAlt} />
<meta name="twitter:card" content="summary_large_image" />
