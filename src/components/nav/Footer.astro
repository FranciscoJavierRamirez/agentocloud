---
// Logo que se traza una vez, navegación, contacto y enlaces legales.
import Logo from '@/components/media/Logo.astro';
import TwinFigure from '@/components/media/TwinFigure.astro';
import ArrowLink from '@/components/ui/ArrowLink.astro';
import TechLabel from '@/components/ui/TechLabel.astro';
import { comunes, destino, ruta, seccion } from '@/lib/i18n';
interface Props { lang: string }
const { lang } = Astro.props;
const [t, pie] = await Promise.all([comunes(lang), seccion(lang, 'pie')]);
---

<footer id={pie.ancla} class="border-linea border-t" aria-label={t.interfaz.navegacion_pie}>
  <TwinFigure lang={lang} codigo={pie.imagen.codigo} alt={pie.imagen.alt} ajuste="llenar" marcas={false} class="aspect-banda max-h-72 w-full" />
  <div class="contenedor flex flex-col gap-10 py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-12">
      <div class="flex flex-col gap-6 sm:col-span-2 lg:col-span-6">
        <Logo alt={pie.logo_alt} trazar class="h-12 w-auto self-start" />
        <TechLabel texto={pie.lema} class="sm:hidden" />
        <p class="rotulo text-texto-2 max-w-lectura max-sm:hidden">{pie.lema}</p>
      </div>
      <ul class="flex flex-col lg:col-span-3">
        {t.navegacion.enlaces.map((enlace) => <li><a href={destino(lang, enlace)} class="text-cuerpo text-tinta min-h-toque flex items-center font-medium no-underline hover:underline hover:underline-offset-4">{enlace.texto}</a></li>)}
      </ul>
      <ul class="flex flex-col lg:col-span-3">
        <li><ArrowLink href={`mailto:${pie.contacto.correo}`}>{pie.contacto.correo}</ArrowLink></li>
        {pie.contacto.linkedin && <li><ArrowLink href={pie.contacto.linkedin} externo avisoExterno={t.interfaz.abre_en_otra_pestana}>{pie.contacto.linkedin_texto}</ArrowLink></li>}
        {pie.enlaces_legales.map((enlace) => <li><ArrowLink href={ruta(lang, enlace.ruta)}>{enlace.texto}</ArrowLink></li>)}
      </ul>
    </div>
    <div class="border-linea text-nota text-texto-2 flex flex-col gap-2 border-t pt-6 pb-20 md:flex-row md:justify-between md:pb-0">
      <p>{pie.derechos}</p>
      <p>{t.organizacion.ciudad}</p>
    </div>
  </div>
</footer>
