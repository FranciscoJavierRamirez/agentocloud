---
// Cruces de registro en las esquinas de un marco: la foto y su gemelo están "en registro".
const esquinas = ['top-2 left-2', 'top-2 right-2', 'bottom-2 left-2', 'bottom-2 right-2'];
---

{
  esquinas.map((posicion) => (
    <svg class:list={['text-tinta pointer-events-none absolute z-(--z-rotulo) size-3 opacity-20', posicion]} viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M6,0 V12 M0,6 H12" stroke="currentColor" stroke-width="1" />
    </svg>
  ))
}
