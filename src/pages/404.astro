---
// Error 404. Un error dice qué pasó y cómo seguir, sin disculpas.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import ReliefTexture from '@/components/media/ReliefTexture.astro';
import { comunes, idiomaPorDefecto, ruta } from '@/lib/i18n';
const lang = idiomaPorDefecto;
const t = await comunes(lang);
---

<BaseLayout lang={lang} titulo={`${t.pagina_404.titulo} · ${t.organizacion.nombre}`} indexar={false}>
  <section class="relative isolate">
    <ReliefTexture class="opacity-60" />
    <div class="contenedor py-seccion flex flex-col items-start gap-6">
      <p class="rotulo text-texto-2">404</p>
      <h1 class="font-display text-titular">{t.pagina_404.titulo}</h1>
      <p class="text-bajada">{t.pagina_404.texto}</p>
      <Button href={ruta(lang)}>{t.pagina_404.boton}</Button>
    </div>
  </section>
</BaseLayout>
